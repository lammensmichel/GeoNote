# Copier en .env pour le developpement local. Ne jamais committer de vraies valeurs.
# En production (Vercel), ces variables se reglent dans Project Settings > Environment Variables.

PORT=8080

# "production" active les verifications de demarrage (secret JWT fort, DATABASE_URL
# obligatoire). Inutile sur Vercel : la variable VERCEL, posee par Vercel, suffit.
APP_ENV=

# Neon : prendre l'URL "pooled" (hote en -pooler), avec sslmode=require.
DATABASE_URL=postgres://geonote:geonote@localhost:5432/geonote?sslmode=disable
# Connexions max par instance. Chaque instance Vercel a son propre pool : 5 conseille.
DB_MAX_CONNS=10

# Production : 32 caracteres minimum, aleatoires (ex. `openssl rand -base64 48`).
# L'API refuse de demarrer avec une valeur d'exemple.
JWT_SECRET=change-me-in-production
JWT_EXPIRY=24h

# Domaines du navigateur autorises a appeler l'API (appli web, page d'accueil),
# separes par des virgules, sans joker. Ex. : https://app.exemple.be,https://exemple.be
# En local, http://localhost:* et http://127.0.0.1:* sont toujours autorises.
CORS_ALLOWED_ORIGINS=

# REDIS_URL est prioritaire sur REDIS_ADDR/PASSWORD/DB.
# Upstash fournit une URL du type rediss://default:<mot-de-passe>@<hote>:6379
REDIS_URL=
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
REDIS_DB=0
CACHE_TTL=10s

# En-tete donnant l'IP du client, ecrit par le proxy devant l'API.
# Vercel : X-Real-IP. Vide en dev/Docker (on utilise l'adresse de connexion).
# Ne jamais mettre un en-tete que le client peut envoyer lui-meme.
TRUSTED_IP_HEADER=
